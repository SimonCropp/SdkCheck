<Project>
  <!--
    Every private property is scoped _SdkCheck_. MSBuild properties are global, so an unscoped name
    written by two imports means the last import wins for the whole project.
  -->
  <PropertyGroup>
    <!--
      One assembly for every host. netstandard2.0 loads under MSBuild on .NET Framework and under
      MSBuild on .NET of any version.

      This deliberately does not select a net10.0 asset for $(MSBuildRuntimeType) == 'Core'.
      'Core' means "MSBuild running on .NET" - it says nothing about which version - so that
      selection handed a net10.0 assembly to every consumer on an older SDK and failed their build
      outright with MSB4062, "Could not load file or assembly 'System.Runtime, Version=10.0.0.0'".
      A task package that only loads on the newest SDK is worse than one that is a little slower.
    -->
    <_SdkCheck_TasksDir>$(MSBuildThisFileDirectory)..\tasks\</_SdkCheck_TasksDir>
    <_SdkCheck_Assembly>$(_SdkCheck_TasksDir)netstandard2.0\SdkCheck.dll</_SdkCheck_Assembly>

    <SdkCheckEnabled Condition="'$(SdkCheckEnabled)' == ''">true</SdkCheckEnabled>
  </PropertyGroup>

  <UsingTask TaskName="SdkCheckTask"
             AssemblyFile="$(_SdkCheck_Assembly)" />

  <!--
    Two targets, because the two checks need different things from the build.

    The SDK check needs only $(NETCoreSdkVersion), so it hangs off BeforeBuild, which every project
    runs. It used to share the runtime target below, and that made it a silent no-op for every
    netstandard2.0 project: those resolve no framework reference, so ResolveFrameworkReferences
    contributes nothing and nothing downstream of it fires. A security check that quietly does
    nothing is worse than one that is absent.

    Deliberately no Inputs/Outputs on either. Incremental skipping would suppress the warning on
    every build after the first, and a diagnostic that disappears on rebuild is worse than the
    millisecond it costs to re-read a cached feed.
  -->
  <Target Name="SdkCheckSdk"
          BeforeTargets="BeforeBuild"
          Condition="'$(SdkCheckEnabled)' == 'true' and
                     '$(DesignTimeBuild)' != 'true' and
                     '$(NCrunch)' != '1'">
    <!--
      The SDK doing the build is the same whichever target framework is being built, so it is
      checked on the first one only. The runtime check below still runs for every target framework,
      because that one genuinely differs per TFM.

      The task also deduplicates in-process, but that cannot be relied on here: MSBuild farms inner
      builds out to separate nodes, and a registered task object lives in one node's registry.

      $(TargetFrameworks) is read through an item rather than split directly, and that is why this
      sits inside the target: a property outside one is evaluated before any item exists.

      The property is routinely written across several lines, and String.Split does not trim, so
      splitting it raw leaves the newline and indentation on the first entry. That entry then
      matches no inner build's $(TargetFramework), which blanked the SDK version for every one of
      them and left the check silently doing nothing for the whole project. Item creation trims each
      entry and drops empty ones, which is why the SDK's own reading of the same property never saw
      this.
    -->
    <ItemGroup Condition="'$(TargetFrameworks)' != ''">
      <_SdkCheck_TargetFramework Include="$(TargetFrameworks)" />
    </ItemGroup>

    <PropertyGroup>
      <_SdkCheck_TargetFrameworks>@(_SdkCheck_TargetFramework)</_SdkCheck_TargetFrameworks>
      <_SdkCheck_SdkVersion>$(NETCoreSdkVersion)</_SdkCheck_SdkVersion>
      <_SdkCheck_SdkVersion
        Condition="'$(_SdkCheck_TargetFrameworks)' != '' and
                   '$(TargetFramework)' != $([MSBuild]::ValueOrDefault('$(_SdkCheck_TargetFrameworks)', '').Split(';')[0])"
      ></_SdkCheck_SdkVersion>
    </PropertyGroup>

    <SdkCheckTask
      SdkVersion="$(_SdkCheck_SdkVersion)"
      IncludeRuntime="false"
      IncludeRuntimePacks="false"
      TreatAsError="$(SdkCheckTreatAsError)"
      EolAsError="$(SdkCheckEolAsError)"
      CacheHours="$(SdkCheckCacheHours)"
      TimeoutSeconds="$(SdkCheckTimeoutSeconds)"
      Offline="$(SdkCheckOffline)"
      CacheDirectory="$(SdkCheckCacheDirectory)"
      FeedOverride="$(SdkCheckFeedOverride)" />
  </Target>

  <!--
    The runtime check does need ResolveFrameworkReferences, so that @(ResolvedFrameworkReference)
    and @(ResolvedRuntimePack) are populated and the versions are read rather than guessed. Having
    nothing to say for a netstandard2.0 project is correct here - such a project targets no runtime.

    Runs once per target framework: a multi-targeted project resolves a different runtime for each.
    SdkVersion is not passed, so the SDK is never reported twice.
  -->
  <Target Name="SdkCheckRuntime"
          AfterTargets="ResolveFrameworkReferences"
          Condition="'$(SdkCheckEnabled)' == 'true' and
                     '$(DesignTimeBuild)' != 'true' and
                     '$(NCrunch)' != '1'">
    <SdkCheckTask
      FrameworkReferences="@(ResolvedFrameworkReference)"
      RuntimePacks="@(ResolvedRuntimePack)"
      TreatAsError="$(SdkCheckTreatAsError)"
      EolAsError="$(SdkCheckEolAsError)"
      IncludeRuntime="$(SdkCheckIncludeRuntime)"
      IncludeRuntimePacks="$(SdkCheckIncludeRuntimePacks)"
      CacheHours="$(SdkCheckCacheHours)"
      TimeoutSeconds="$(SdkCheckTimeoutSeconds)"
      Offline="$(SdkCheckOffline)"
      CacheDirectory="$(SdkCheckCacheDirectory)"
      FeedOverride="$(SdkCheckFeedOverride)" />
  </Target>
</Project>
