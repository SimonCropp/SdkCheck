    <PackageVersion Include="ProjectDefaults" Version="1.0.180" />
    <PackageVersion Include="TUnit" Version="1.66.27" />
    <PackageVersion Include="Verify" Version="33.0.0-beta.11" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.0.0-beta.11" />
  </ItemGroup>
</Project>
